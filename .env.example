# ==============================================================================
# AI-Based Irrigation Management System - Environment Variables Configuration
# ==============================================================================
# Copy this file to '.env' and fill in the values for local development.
# Do NOT commit the actual '.env' file containing secrets to version control!

# ------------------------------------------------------------------------------
# Backend (FastAPI) Settings
# ------------------------------------------------------------------------------
BACKEND_APP_NAME="AI Irrigation Management Backend"
BACKEND_DEBUG=true
BACKEND_ENV=development # development, staging, production
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ------------------------------------------------------------------------------
# Security & Authentication (JWT)
# ------------------------------------------------------------------------------
# Generate a secure key using: openssl rand -hex 32
JWT_SECRET_KEY=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# PostgreSQL Database Settings
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_irrigation_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy Database URLs
# Local Development Example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_irrigation_db
# Supabase / Render Production PostgreSQL Connection String Example:
# Direct: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# Pooler: postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:YOUR_SUPABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:YOUR_SUPABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# ------------------------------------------------------------------------------
# Supabase API Credentials (Optional)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImxocWFqYmxvZWppZW90eGpydWxhIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODk2OTYyNzQsImV4cCI6MjEwNTI3MjI3NH0.19zBAGtCd9KCjZwd32B-j1w8kMsqF3u61wWDpGvRvQ0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImxocWFqYmxvZWppZW90eGpydWxhIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4OTY5NjI3NCwiZXhwIjoyMTA1MjcyMjc0fQ.XjOAt0edE-UR8GZq5yT5kR0buZutDzWaITAaAZz53-g

# ------------------------------------------------------------------------------
# External API Configurations
# ------------------------------------------------------------------------------
# OpenWeather API: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# Open-Meteo provides current, hourly and daily forecasts without a key for basic use.
# Set WEATHER_API_KEY only when using a managed Open-Meteo plan that requires one.
WEATHER_PROVIDER=open_meteo
WEATHER_API_KEY=
WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_CACHE_TTL_SECONDS=900

# Sarvam AI API (Voice synthesis/recognition/translation in regional languages)
SARVAM_AI_API_KEY=your_sarvam_ai_api_key_here
SARVAM_AI_BASE_URL=https://api.sarvam.ai

# ------------------------------------------------------------------------------
# Machine Learning Configs
# ------------------------------------------------------------------------------
ML_MODELS_PATH=../ml/models
ML_DEFAULT_SOIL_MOISTURE_THRESHOLD=0.35 # e.g. 35% volumetric soil moisture
CROP_OPTIMIZATION_MODEL_TYPE=random_forest # random_forest, lstm

# ------------------------------------------------------------------------------
# Frontend (Next.js) Settings
# ------------------------------------------------------------------------------
# Must prefix with NEXT_PUBLIC_ to expose to the browser in Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_PWA=true
